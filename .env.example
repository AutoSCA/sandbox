# AWS 자격 증명 (실제 키 값을 .env 파일에 입력하세요)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# AWS 리소스
S3_BUCKET=gachon-p-project-sca
DYNAMO_DB_TABLE_SANDBOX=gachon-p-project-sca-sandbox
DYNAMO_DB_TABLE_REPORT=gachon-p-project-sca-report

# 로컬 작업 경로
DOWNLOAD_DIR=./downloads
RESULT_DIR=./results

# 워커 실행 설정
POLL_INTERVAL_MS=5000
MAX_CONCURRENT_JOBS=3
ENABLE_LOG=true
